// RegioTicket — Prisma Schema principal
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  SUPER_ADMIN
  ADMIN
  CAJERO
  VALIDADOR
}

enum EstadoEvento {
  BORRADOR
  ACTIVO
  PAUSADO
  FINALIZADO
}

enum EstadoOrden {
  PENDIENTE
  PAGADA
  EXPIRADA
  REEMBOLSADA
  FALLIDA
}

enum EstadoBoleto {
  VALIDO
  USADO
  CANCELADO
}

enum CanalVenta {
  ONLINE
  TAQUILLA
}

enum FormaPago {
  MERCADOPAGO
  EFECTIVO
  TARJETA
  CORTESIA
}

enum TipoItem {
  BOLETO
  PRODUCTO
}

enum TipoDistribucion {
  GENERAL
  NUMERADO
  MESA
}

// ─── MULTI-TENANT ───────────────────────────────────────────────────────────

model Empresa {
  id        String   @id @default(cuid())
  nombre    String
  slug      String   @unique
  logo      String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  usuarios  Usuario[]
  eventos   Evento[]
  ordenes   Orden[]
  config    ConfigEmpresa?
}

model ConfigEmpresa {
  id                  String   @id @default(cuid())
  empresaId           String   @unique
  empresa             Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // Email SMTP
  smtpHost            String?
  smtpPort            Int      @default(587)
  smtpUser            String?
  smtpPass            String?
  smtpFrom            String?
  smtpFromNombre      String?

  // WhatsApp
  waProvider          String   @default("link")  // link | meta
  waToken             String?
  waPhoneId           String?
  waFrom              String?

  // Ventana de validación (horas)
  ventanaAntesHoras   Int      @default(4)
  ventanaDespuesHoras Int      @default(2)

  // Apariencia del subdominio
  colorPrimario       String?
  descripcionCorta    String?
  heroTexto           String?
  bannerUrl           String?
  facebook            String?
  instagram           String?
  tiktok              String?
  emailContacto       String?
  telefonoContacto    String?

  updatedAt           DateTime @updatedAt
}

// ─── USUARIOS ───────────────────────────────────────────────────────────────

model Usuario {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nombre    String
  rol       Rol      @default(CAJERO)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  eventos Evento[]
  ordenes Orden[]  @relation("CajeroOrdenes")

  @@index([empresaId])
}

// ─── EVENTOS ────────────────────────────────────────────────────────────────

model Evento {
  id            String       @id @default(cuid())
  slug          String       @unique
  nombre        String
  descripcion   String?
  lugar         String
  fechaEvento   DateTime
  fechaFin      DateTime?
  imagen        String?
  estado        EstadoEvento @default(BORRADOR)
  ventaOnline   Boolean      @default(true)
  ventaTaquilla Boolean      @default(true)
  organizadorId String
  organizador   Usuario      @relation(fields: [organizadorId], references: [id])

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  categorias Categoria[]
  ordenes    Orden[]
  mapaVenue  MapaVenue?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([empresaId])
}

// ─── CATEGORÍAS ─────────────────────────────────────────────────────────────

model Categoria {
  id                String           @id @default(cuid())
  eventoId          String
  evento            Evento           @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  nombre            String
  precio            Decimal          @db.Decimal(10, 2)
  totalBoletos      Int
  disponibles       Int
  activaOnline      Boolean          @default(true)
  activaTaquilla    Boolean          @default(true)
  ordenDisplay      Int              @default(0)
  tipoDistribucion  TipoDistribucion @default(GENERAL)
  capacidadMesa     Int?
  items             ItemOrden[]
  boletos           Boleto[]
  createdAt         DateTime         @default(now())

  @@index([eventoId])
}

// ─── PRODUCTOS ──────────────────────────────────────────────────────────────

model Producto {
  id          String      @id @default(cuid())
  nombre      String
  descripcion String?
  precio      Decimal     @db.Decimal(10, 2)
  stock       Int         @default(0)
  imagen      String?
  activo      Boolean     @default(true)
  eventoId    String?
  items       ItemOrden[]
  createdAt   DateTime    @default(now())
}

// ─── ÓRDENES ────────────────────────────────────────────────────────────────

model Orden {
  id                 String      @id @default(cuid())
  eventoId           String
  evento             Evento      @relation(fields: [eventoId], references: [id])
  canal              CanalVenta
  formaPago          FormaPago
  estado             EstadoOrden @default(PENDIENTE)
  compradorNombre    String?
  compradorEmail     String?
  compradorTel       String?
  compradorWhatsapp  String?
  total              Decimal     @db.Decimal(10, 2)
  mpPaymentId        String?
  mpPreferenciaId    String?
  referenciaPago     String?
  cajeroId           String?
  cajero             Usuario?    @relation("CajeroOrdenes", fields: [cajeroId], references: [id])

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  items     ItemOrden[]
  boletos   Boleto[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  expiresAt DateTime?

  @@index([eventoId, estado])
  @@index([empresaId, estado])
  @@index([createdAt])
}

model ItemOrden {
  id             String     @id @default(cuid())
  ordenId        String
  orden          Orden      @relation(fields: [ordenId], references: [id])
  tipoItem       TipoItem
  categoriaId    String?
  categoria      Categoria? @relation(fields: [categoriaId], references: [id])
  productoId     String?
  producto       Producto?  @relation(fields: [productoId], references: [id])
  cantidad       Int
  precioUnitario Decimal    @db.Decimal(10, 2)
  subtotal       Decimal    @db.Decimal(10, 2)
}

// ─── BOLETOS ────────────────────────────────────────────────────────────────

model Boleto {
  id               String       @id @default(uuid())
  ordenId          String
  orden            Orden        @relation(fields: [ordenId], references: [id])
  categoriaId      String
  categoria        Categoria    @relation(fields: [categoriaId], references: [id])
  numero           Int
  estado           EstadoBoleto @default(VALIDO)
  qrFirma          String?
  intentosFallidos Int          @default(0)
  accesos          Acceso[]
  createdAt        DateTime     @default(now())

  @@index([estado])
}

// ─── ACCESOS ────────────────────────────────────────────────────────────────

model Acceso {
  id          String   @id @default(cuid())
  boletoId    String
  boleto      Boleto   @relation(fields: [boletoId], references: [id])
  timestamp   DateTime @default(now())
  validadorId String?
  dispositivo String?
  exitoso     Boolean  @default(true)
  motivo      String?
}

// ─── CONFIGURACIÓN ──────────────────────────────────────────────────────────

model ConfigSistema {
  id    String @id @default(cuid())
  clave String @unique
  valor String
}

model MapaVenue {
  id        String   @id @default(cuid())
  eventoId  String   @unique
  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  elementos Json     @default("[]")
  anchoM    Float    @default(20)
  altoM     Float    @default(15)
  updatedAt DateTime @updatedAt
}

model TokenReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usado     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

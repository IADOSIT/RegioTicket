# Base de datos — postgres_local en web_network
DATABASE_URL=postgresql://administrador:PASS@postgres_local:5432/regioticket

# JWT — mínimo 32 caracteres
JWT_SECRET=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://regioticket.mx

# MercadoPago México
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# URL pública de la API (usada por el frontend)
NEXT_PUBLIC_API_URL=https://regioticket.mx/api

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@regioticket.mx
SMTP_PASS=

# WhatsApp via Twilio (opcional)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP=whatsapp:+14155238886
